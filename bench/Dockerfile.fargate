# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.23-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/bench .

FROM public.ecr.aws/docker/library/debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/bench /app/bench
COPY --chmod=0755 fargate-entrypoint.sh /usr/local/bin/fargate-entrypoint

ENTRYPOINT ["/usr/local/bin/fargate-entrypoint"]
CMD ["/app/bench", "run"]
