# /etc/mysql/conf.d
# ISURIDE MySQL tuning
# DB専用ホスト(contestant-02)用。COMMIT の fsync 律速を避けるための設定。
# pt-query-digest で COMMIT avg 42ms を観測したことへの対応。
[mysqld]
# binlog 不要（レプリカ・PITR なし）のため無効化。COMMIT 毎の binlog fsync を消す
skip-log-bin
# redo flush を COMMIT 毎→1秒毎に。クラッシュ時は最大1秒分失う
innodb_flush_log_at_trx_commit = 2
# バッファプール (DB専用ホスト RAM 4GB 想定)
innodb_buffer_pool_size = 2G
# SELECT ... FOR UPDATE のギャップロック起因デッドロックを抑える。
# 行ロックは維持されるため invite上限3・クーポン単一割当の正しさは保たれる
transaction-isolation = READ-COMMITTED
